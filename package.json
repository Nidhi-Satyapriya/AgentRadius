{
  "name": "agentradius",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first permission intelligence, blast-radius analysis, and MCP policy control for macOS.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:api": "node --watch src/api/main.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "node src/api/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src scripts tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schemas": "node scripts/generate-schemas.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
