{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentradius.dev/schemas/finding.schema.json",
  "title": "AgentRadius Finding",
  "type": "object",
  "required": [
    "id",
    "rule_id",
    "title",
    "severity",
    "confidence",
    "status",
    "affected_entity_ids",
    "rationale",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "rule_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "enum": [
        "open",
        "accepted_risk",
        "in_progress",
        "resolved",
        "false_positive"
      ]
    },
    "affected_entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "path_edge_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remediation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "rule_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
